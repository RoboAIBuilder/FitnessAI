# Copy to .env and fill in. Local development works with the defaults.
DATABASE_URL=sqlite:///./fitnessai.db
# Production (Supabase Postgres): postgresql+psycopg://postgres:<password>@db.<project>.supabase.co:5432/postgres

# dev = no sign-in (acts as the demo trainer). supabase = verify Supabase Auth tokens.
AUTH_MODE=dev
SUPABASE_JWT_SECRET=

# App notifications. Generate with: python -m app.notify --generate-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:coach@example.com

CORS_ORIGINS=http://localhost:5173
TRAINER_TZ=America/New_York
# 1 = load the sample trainer and clients into an empty database
SEED_DEMO=1
