# Copy to .env for local runs. On Vercel, set these in Project → Settings → Environment Variables.

# Database: Vercel → Storage → Create → Neon (Postgres), connected to the API project, sets DATABASE_URL.
# Leave empty locally to use a SQLite file.
DATABASE_URL=

# Sign-in. The trainer's code (required on Vercel). Clients sign in with their own code (first name by default).
TRAINER_CODE=coach
# Optional: signs session tokens. Without it the app makes one and keeps it in the database.
SECRET_KEY=
# dev = no sign-in (local testing only)
AUTH_MODE=code

# The web app's address (comma-separated if more than one); optional regex for Vercel preview URLs
CORS_ORIGINS=http://localhost:5173
CORS_ORIGIN_REGEX=

# App notifications (optional). Generate with: python -m app.notify --generate-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:coach@example.com

TRAINER_TZ=America/New_York
# 1 = load the sample trainer and clients into an empty database (handy for a demo; set 0 for real use)
SEED_DEMO=1
